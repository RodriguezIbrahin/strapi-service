{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "nombre": {
      "type": "string"
    },
    "apellido": {
      "type": "string"
    },
    "sexo": {
      "type": "string"
    },
    "edad": {
      "type": "integer"
    },
    "fechaDeNacimiento": {
      "type": "date"
    },
    "pais": {
      "type": "string"
    },
    "ciudad": {
      "type": "string"
    },
    "domicilio": {
      "type": "string"
    },
    "telefono": {
      "type": "biginteger"
    },
    "avatar": {
      "type": "string"
    },
    "rol": {
      "type": "string",
      "default": "user"
    },
    "equipo_proyecto_58": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::equipo58.equipo58",
      "inversedBy": "miembros"
    },
    "proyecto_56s": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::proyecto-56.proyecto-56",
      "mappedBy": "usuario"
    }
  }
}
